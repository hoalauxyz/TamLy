# Sao chép thành .env để chạy local. KHÔNG commit .env.

PORT=3000
HOST=0.0.0.0

# Đường dẫn SQLite (dev). Production: PostgreSQL + mã hóa at-rest (xem README "Trước khi cho người dùng thật").
DB_PATH=./data/tamly.dev.sqlite

# LLM – bỏ trống để chạy chế độ no-LLM (chỉ kịch bản). Tương thích OpenAI Chat Completions:
# OpenAI: https://api.openai.com/v1 | Groq: https://api.groq.com/openai/v1 | Ollama local: http://localhost:11434/v1
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini

# Kill-switch: đặt =1 để tắt LLM toàn hệ thống ngay lập tức (vẫn chạy kịch bản).
LLM_DISABLED=0

# 0 = không giới hạn tin nhắn (bản thử nghiệm miễn phí).
CHAT_DAILY_LIMIT=0

# Token cho endpoint /v1/admin/* (Safety Ops). Đổi giá trị này.
ADMIN_TOKEN=change-me

# Lưu nội dung tin nhắn khi có sự kiện crisis để review có kiểm soát? (0 = chỉ lưu metadata)
STORE_CRISIS_TEXT=0

# Bảng chat_messages giữ để tương thích / dọn dữ liệu cũ. API hiện không INSERT transcript.
CHAT_RETENTION_DAYS=30

# URL JSON gói tri thức đã duyệt (reviewed:true). Trống = chỉ dùng gói đóng trong app.
# Không dùng để crawl bài báo hay fine-tune.
KNOWLEDGE_URL=
